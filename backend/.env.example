# Copy to .env and adjust. Never commit real secrets.
APP_NAME="Gate Access Management System"
COMPANY_NAME="Acme Industries"

DATABASE_URL=postgresql+psycopg2://gate:gate@db:5432/gate

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_MINUTES=480

# Base URL of the web app; pass links and QR codes are built from it.
PUBLIC_BASE_URL=http://localhost:5173

STORAGE_DIR=/data/storage
MAX_UPLOAD_BYTES=10485760
ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png

VERIFY_RATE_LIMIT=60
VERIFY_RATE_WINDOW_SECONDS=60

# First-run super admin. Change the password immediately after logging in.
BOOTSTRAP_EMAIL=admin@company.com
BOOTSTRAP_PASSWORD=ChangeMe123!
